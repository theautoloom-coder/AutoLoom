# Copy to .env for local development. All keys are safe to ship in the app
# bundle: Supabase's anon key and PowerSync's URL are public by design; row
# level security and JWT validation protect the data.

# Local Supabase (from `supabase status`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Local PowerSync (docker compose -f powersync/docker-compose.yml up -d)
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080

# When testing on a physical phone, replace 127.0.0.1 above with your PC's LAN
# IP so the phone can reach Supabase and PowerSync.

# Not public, and not part of the app: an expo.dev access token, used only to
# start an EAS build and read its artifact URL from this machine. eas-cli takes
# it from the environment, so the build command exports it out of .env. It has
# no EXPO_PUBLIC_ prefix, so Metro never inlines it into the bundle — but .env
# is gitignored either way, and this file must never carry the real value.
# expo.dev -> Account settings -> Access tokens
EXPO_TOKEN=replace-with-an-expo-access-token
